#!/usr/bin/env python3
"""Fail-closed Trunk-Based Development UOW lifecycle."""

from __future__ import annotations

import argparse
import base64
import datetime as dt
import fnmatch
import json
import os
import re
import shlex
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any

ZERO_SHA = "0" * 40
JIRA_RE = re.compile(r"^SCRUM-[0-9]+$")
PASS = {"PASS", "PASSED"}
ADMITTED = {"CANDIDATE_ADMITTED", "PASS"}
REQUIRED_MANIFEST_FIELDS = {
    "schema", "goal_id", "repository", "branch", "head", "state",
    "plan", "evidence", "jira",
}


class UowError(RuntimeError):
    pass


def run(args: list[str], *, cwd: Path, check: bool = True) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(args, cwd=cwd, text=True, capture_output=True)
    if check and result.returncode:
        detail = (result.stderr or result.stdout).strip()
        raise UowError(f"{shlex.join(args)} failed: {detail}")
    return result


def git(repo: Path, *args: str, check: bool = True) -> str:
    return run(["git", *args], cwd=repo, check=check).stdout.strip()


def repo_root() -> Path:
    return Path(git(Path.cwd(), "rev-parse", "--show-toplevel")).resolve()


def common_git_dir(repo: Path) -> Path:
    raw = git(repo, "rev-parse", "--git-common-dir")
    path = Path(raw)
    return (repo / path).resolve() if not path.is_absolute() else path.resolve()


def lease_path(repo: Path) -> Path:
    return common_git_dir(repo) / "spacetime-uow.json"

def admission_path(repo: Path) -> Path:
    return common_git_dir(repo) / "spacetime-uow-admission.json"


def read_json(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise UowError(f"invalid JSON-compatible YAML at {path}: {exc}") from exc
    if not isinstance(value, dict):
        raise UowError(f"manifest must be an object: {path}")
    return value


def write_lease(path: Path, lease: dict[str, Any]) -> None:
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    try:
        fd = os.open(path, flags, 0o600)
    except FileExistsError as exc:
        raise UowError(f"active UOW lease exists: {path}") from exc
    with os.fdopen(fd, "w", encoding="utf-8") as stream:
        json.dump(lease, stream, indent=2, sort_keys=True)
        stream.write("\n")


def load_lease(repo: Path) -> dict[str, Any]:
    path = lease_path(repo)
    if not path.is_file():
        raise UowError(f"no active UOW lease: {path}")
    lease = read_json(path)
    required = {"jira", "branch", "base", "started_at", "goal_manifest"}
    if set(lease) != required:
        raise UowError("UOW lease has an unexpected shape")
    return lease


def local_branches(repo: Path) -> list[str]:
    return sorted(filter(None, git(repo, "branch", "--format=%(refname:short)").splitlines()))


def tracking_branches(repo: Path) -> list[str]:
    refs = git(repo, "for-each-ref", "--format=%(refname)", "refs/remotes/origin")
    return sorted(ref.removeprefix("refs/remotes/") for ref in refs.splitlines() if ref)


def remote_heads(repo: Path) -> dict[str, str]:
    output = git(repo, "ls-remote", "--heads", "origin")
    result: dict[str, str] = {}
    for line in output.splitlines():
        sha, ref = line.split()
        result[ref.removeprefix("refs/heads/")] = sha
    return result


def worktrees(repo: Path) -> list[Path]:
    output = git(repo, "worktree", "list", "--porcelain")
    return [Path(line[9:]).resolve() for line in output.splitlines() if line.startswith("worktree ")]


def clean(repo: Path) -> bool:
    return not git(repo, "status", "--porcelain=v1", "--untracked-files=all")


def require_main_topology(repo: Path, *, jira_done: bool = False) -> None:
    errors: list[str] = []
    if git(repo, "branch", "--show-current") != "main":
        errors.append("current branch must be main")
    if not clean(repo):
        errors.append("working tree must be clean")
    if local_branches(repo) != ["main"]:
        errors.append(f"local branches must be [main], got {local_branches(repo)}")
    if tracking_branches(repo) != ["origin/main"]:
        errors.append(f"remote-tracking branches must be [origin/main], got {tracking_branches(repo)}")
    if worktrees(repo) != [repo.resolve()]:
        errors.append("only the canonical main worktree may exist")
    main = git(repo, "rev-parse", "main")
    origin = git(repo, "rev-parse", "origin/main")
    live = remote_heads(repo)
    if sorted(live) != ["main"]:
        errors.append(f"remote heads must be [main], got {sorted(live)}")
    if live.get("main") != main or origin != main:
        errors.append("main, origin/main, and remote main SHA must match")
    if lease_path(repo).exists():
        errors.append("no active UOW lease may exist")
    if errors:
        raise UowError("; ".join(errors))


def jira_request(method: str, path: str, payload: dict[str, Any] | None = None) -> Any:
    base = os.environ.get("JIRA_BASE_URL", "").rstrip("/")
    email = os.environ.get("JIRA_EMAIL", "")
    token = os.environ.get("JIRA_API_TOKEN", "")
    if not base or not email or not token:
        raise UowError("JIRA_BASE_URL, JIRA_EMAIL, and JIRA_API_TOKEN are required")
    body = json.dumps(payload).encode() if payload is not None else None
    auth = base64.b64encode(f"{email}:{token}".encode()).decode()
    request = urllib.request.Request(
        f"{base}{path}", data=body, method=method,
        headers={"Authorization": f"Basic {auth}", "Accept": "application/json",
                 "Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            raw = response.read()
            return json.loads(raw) if raw else None
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode(errors="replace")
        raise UowError(f"Jira {method} {path} failed ({exc.code}): {detail}") from exc


def require_jira_current_sprint(jira: str) -> None:
    jql = urllib.parse.quote(f'key = "{jira}" AND sprint in openSprints()')
    data = jira_request("GET", f"/rest/api/3/search/jql?jql={jql}&maxResults=1&fields=status")
    issues = data.get("issues", []) if isinstance(data, dict) else []
    if len(issues) != 1:
        raise UowError(f"{jira} does not exist in the current sprint")


def jira_status(jira: str) -> str:
    data = jira_request("GET", f"/rest/api/3/issue/{jira}?fields=status")
    return data["fields"]["status"]["name"]


def jira_finish(jira: str, comment: str) -> None:
    adf = {"type": "doc", "version": 1, "content": [
        {"type": "paragraph", "content": [{"type": "text", "text": comment}]}
    ]}
    jira_request("POST", f"/rest/api/3/issue/{jira}/comment", {"body": adf})
    if jira_status(jira).lower() == "done":
        return
    transitions = jira_request("GET", f"/rest/api/3/issue/{jira}/transitions")
    done = next((item for item in transitions.get("transitions", [])
                 if item.get("to", {}).get("statusCategory", {}).get("key") == "done"), None)
    if not done:
        raise UowError(f"{jira} has no available Done transition")
    jira_request("POST", f"/rest/api/3/issue/{jira}/transitions",
                 {"transition": {"id": done["id"]}})
    if jira_status(jira).lower() != "done":
        raise UowError(f"{jira} did not read back as Done")


def manifest_candidates(repo: Path, jira: str) -> list[Path]:
    matches: list[Path] = []
    paths = list(repo.glob("docs/verification/**/goal-manifest.yaml"))
    paths.extend((common_git_dir(repo) / "spacetime-goals").glob("**/goal-manifest.yaml"))
    for path in paths:
        try:
            data = read_json(path)
        except UowError:
            continue
        if jira in data.get("jira", {}).get("issues", []):
            matches.append(path.resolve())
    return matches


def validate_manifest(repo: Path, path: Path, jira: str, *, start: bool) -> dict[str, Any]:
    validator = repo / "docs" / "goals" / "validate_goal_manifest.py"
    schema = repo / "docs" / "goals" / "schema.json"
    if not validator.is_file() or not schema.is_file():
        raise UowError("canonical goal-manifest validator and schema are required")
    command = [sys.executable, str(validator), str(path), "--schema", str(schema)]
    if start:
        command.extend(["--repo", str(repo)])
    result = run(command,
                 cwd=repo, check=False)
    if result.returncode:
        raise UowError(f"goal manifest validation failed: {(result.stdout or result.stderr).strip()}")
    data = read_json(path)
    missing = REQUIRED_MANIFEST_FIELDS - set(data)
    if missing:
        raise UowError(f"manifest missing fields: {sorted(missing)}")
    if data.get("schema") != "spacetime.goal_manifest/v1":
        raise UowError("unsupported goal manifest schema")
    if jira not in data.get("jira", {}).get("issues", []):
        raise UowError("manifest Jira identity mismatch")
    if Path(data.get("repository", "")).resolve() != repo:
        raise UowError("manifest repository identity mismatch")
    units = data.get("plan", {}).get("units_of_work", [])
    if not isinstance(units, list) or not units:
        raise UowError("manifest must declare at least one unit of work")
    return data


def uow_record(manifest: dict[str, Any], jira: str) -> dict[str, Any]:
    units = manifest["plan"]["units_of_work"]
    matches = [item for item in units if isinstance(item, dict)
               and (item.get("jira") == jira or jira in item.get("jira_issues", []))]
    if len(matches) != 1:
        raise UowError("manifest must contain exactly one matching UOW record")
    record = matches[0]
    required = {"branch", "authorized_files", "evidence_paths",
                "focused_tests", "broader_tests", "integrated_gates"}
    missing = required - set(record)
    if missing:
        raise UowError(f"UOW record missing fields: {sorted(missing)}")
    if record["branch"] != f"uow/{jira}":
        raise UowError("manifest UOW branch identity mismatch")
    for key in ("authorized_files", "evidence_paths", "focused_tests",
                "broader_tests", "integrated_gates"):
        if not isinstance(record[key], list) or (key != "evidence_paths" and not record[key]):
            raise UowError(f"UOW {key} must be a non-empty list")
    return record


def path_allowed(path: str, patterns: list[str]) -> bool:
    normalized = path.replace(os.sep, "/")
    return any(fnmatch.fnmatchcase(normalized, pattern.rstrip("/"))
               or fnmatch.fnmatchcase(normalized, pattern.rstrip("/") + "/**")
               for pattern in patterns)


def changed_paths(repo: Path, base: str) -> list[str]:
    tracked = git(repo, "diff", "--name-only", f"{base}..HEAD").splitlines()
    staged = git(repo, "diff", "--name-only", "--cached").splitlines()
    unstaged = git(repo, "diff", "--name-only").splitlines()
    untracked = git(repo, "ls-files", "--others", "--exclude-standard").splitlines()
    return sorted(set(filter(None, tracked + staged + unstaged + untracked)))


def run_gates(repo: Path, commands: list[str], label: str) -> None:
    for command in commands:
        result = subprocess.run(command, cwd=repo, shell=True)
        if result.returncode:
            raise UowError(f"{label} failed ({result.returncode}): {command}")


def require_admission(repo: Path, lease: dict[str, Any], head: str) -> None:
    path = admission_path(repo)
    if not path.is_file():
        raise UowError(f"independent admission record is missing: {path}")
    record = read_json(path)
    expected = {
        "jira": lease["jira"],
        "branch": lease["branch"],
        "base": lease["base"],
        "head": head,
        "tree": git(repo, "rev-parse", f"{head}^{{tree}}"),
        "goal_manifest": lease["goal_manifest"],
        "result": "PASS",
        "disposition": "CANDIDATE_ADMITTED",
    }
    for key, value in expected.items():
        if record.get(key) != value:
            raise UowError(f"independent admission {key} does not match the lease/candidate")
    if set(record) != set(expected) | {"coordinator_task_identity", "recorded_at"}:
        raise UowError("independent admission record has an unexpected shape")
    if not record.get("coordinator_task_identity"):
        raise UowError("independent admission coordinator identity is missing")
    try:
        started = dt.datetime.fromisoformat(lease["started_at"].replace("Z", "+00:00"))
        recorded = dt.datetime.fromisoformat(record["recorded_at"].replace("Z", "+00:00"))
    except (TypeError, ValueError) as exc:
        raise UowError("invalid lease/admission timestamp") from exc
    if recorded <= started:
        raise UowError("independent admission predates the active UOW")


def verify(repo: Path, lease: dict[str, Any], *, run_tests: bool = True) -> tuple[dict[str, Any], dict[str, Any]]:
    jira = lease["jira"]
    if git(repo, "branch", "--show-current") != lease["branch"]:
        raise UowError("current branch does not match lease")
    path = Path(lease["goal_manifest"]).resolve()
    manifest = validate_manifest(repo, path, jira, start=False)
    record = uow_record(manifest, jira)
    allowed = record["authorized_files"]
    evidence = record["evidence_paths"]
    violations = [path for path in changed_paths(repo, lease["base"])
                  if not path_allowed(path, allowed + evidence)]
    if violations:
        raise UowError(f"changed paths exceed authorized scope: {violations}")
    untracked = git(repo, "ls-files", "--others", "--exclude-standard").splitlines()
    bad_untracked = [path for path in untracked if not path_allowed(path, evidence)]
    if bad_untracked:
        raise UowError(f"untracked files outside evidence paths: {bad_untracked}")
    if run_tests:
        run_gates(repo, record["focused_tests"], "focused test")
        run_gates(repo, record["broader_tests"], "broader test")
    run(["git", "diff", "--check", lease["base"], "HEAD"], cwd=repo)
    run(["git", "diff", "--check"], cwd=repo)
    head = git(repo, "rev-parse", "HEAD")
    if git(repo, "rev-list", "--count", f'{lease["base"]}..{head}') != "1":
        raise UowError("candidate must be exactly one commit after recorded base")
    if git(repo, "rev-parse", f"{head}^") != lease["base"]:
        raise UowError("candidate commit must descend directly from recorded base")
    subject = git(repo, "show", "-s", "--format=%s", head)
    if not subject.startswith(f"{jira}:"):
        raise UowError(f"commit subject must begin {jira}:")
    if git(repo, "diff", "--name-only") or git(repo, "diff", "--cached", "--name-only"):
        raise UowError("tracked staged/unstaged changes are not permitted")
    require_admission(repo, lease, head)
    print(f"VERIFIED {jira} {head}")
    return manifest, record


def start(repo: Path, jira: str, manifest_arg: str | None) -> None:
    if not JIRA_RE.fullmatch(jira):
        raise UowError("Jira key must match SCRUM-####")
    git(repo, "fetch", "--prune", "origin")
    require_main_topology(repo)
    require_jira_current_sprint(jira)
    if jira_status(jira).lower() == "done":
        raise UowError(f"{jira} is already Done")
    if admission_path(repo).exists():
        raise UowError(f"stale UOW admission record exists: {admission_path(repo)}")
    candidates = [Path(manifest_arg).resolve()] if manifest_arg else manifest_candidates(repo, jira)
    if len(candidates) != 1:
        raise UowError(f"expected exactly one goal manifest for {jira}, got {len(candidates)}")
    manifest = validate_manifest(repo, candidates[0], jira, start=True)
    record = uow_record(manifest, jira)
    branch = f"uow/{jira}"
    lease = {
        "jira": jira,
        "branch": branch,
        "base": git(repo, "rev-parse", "main"),
        "started_at": dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z"),
        "goal_manifest": str(candidates[0]),
    }
    write_lease(lease_path(repo), lease)
    try:
        git(repo, "switch", "-c", branch, "main")
    except Exception:
        lease_path(repo).unlink(missing_ok=True)
        raise
    print(f"STARTED {jira} on {branch}")


def finish(repo: Path) -> None:
    lease = load_lease(repo)
    jira = lease["jira"]
    if git(repo, "branch", "--show-current") == "main":
        if lease["branch"] not in local_branches(repo):
            raise UowError("leased UOW branch is missing")
        main_before = git(repo, "rev-parse", "main")
        candidate_before = git(repo, "rev-parse", lease["branch"])
        if main_before not in {lease["base"], candidate_before}:
            raise UowError("main is neither the recorded base nor the leased candidate")
        git(repo, "switch", lease["branch"])
    manifest, record = verify(repo, lease)
    if git(repo, "ls-files", "--others", "--exclude-standard"):
        raise UowError("finish requires all declared evidence to be tracked in the candidate commit")
    candidate = git(repo, "rev-parse", "HEAD")
    git(repo, "switch", "main")
    git(repo, "fetch", "--prune", "origin")
    main_before = git(repo, "rev-parse", "main")
    origin_before = git(repo, "rev-parse", "origin/main")
    if main_before == lease["base"]:
        if origin_before != lease["base"]:
            raise UowError("main must equal origin/main before integration")
        git(repo, "merge", "--ff-only", lease["branch"])
    elif main_before == candidate:
        if origin_before not in {lease["base"], candidate}:
            raise UowError("origin/main is incompatible with resumed finalization")
    else:
        raise UowError("main is neither the recorded base nor the candidate")
    run_gates(repo, record["integrated_gates"], "integrated-result gate")
    if not clean(repo):
        raise UowError("integrated-result gates left the working tree dirty")
    if git(repo, "rev-parse", "origin/main") != candidate:
        git(repo, "push", "origin")
    git(repo, "fetch", "--prune", "origin")
    live = remote_heads(repo)
    main = git(repo, "rev-parse", "main")
    if main != git(repo, "rev-parse", "origin/main") or live.get("main") != main:
        raise UowError("post-push main SHA proof failed")
    jira_finish(jira, f"{jira} completed on main at {main}. Candidate {candidate}. "
                       "Focused, broader, diff, admission, integration, push, and SHA gates passed.")
    if jira_status(jira).lower() != "done":
        raise UowError(f"{jira} did not read back as Done")
    git(repo, "branch", "-d", lease["branch"])
    admission_path(repo).unlink()
    lease_path(repo).unlink()
    require_main_topology(repo)
    print(f"FINISHED {jira} {main}")


def main() -> int:
    parser = argparse.ArgumentParser(prog="trunk-uow")
    sub = parser.add_subparsers(dest="operation", required=True)
    start_parser = sub.add_parser("start")
    start_parser.add_argument("jira")
    start_parser.add_argument("--manifest")
    sub.add_parser("verify")
    sub.add_parser("finish")
    args = parser.parse_args()
    repo = repo_root()
    try:
        if args.operation == "start":
            start(repo, args.jira, args.manifest)
        elif args.operation == "verify":
            verify(repo, load_lease(repo))
        else:
            finish(repo)
    except UowError as exc:
        print(f"REJECTED: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
