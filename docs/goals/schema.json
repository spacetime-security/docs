{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spacetimesecurity.ai/schemas/goal-manifest-v1.json",
  "title": "Spacetime Goal Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "goal_id", "title", "created_at", "updated_at",
    "repository", "branch", "head", "state", "objective",
    "acceptance_criteria", "plan", "coordination", "evidence", "jira", "release"
  ],
  "properties": {
    "schema": {"const": "spacetime.goal_manifest/v1"},
    "goal_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "title": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "repository": {"type": "string", "minLength": 1},
    "branch": {"type": "string", "minLength": 1},
    "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "state": {
      "type": "string",
      "enum": ["DISCOVERED", "HANDSHAKE_PENDING", "ACKED", "IMPLEMENTING", "LANE_READY", "VERIFYING", "BARRIER_READY", "E2E_RUNNING", "CORRELATING", "VERIFIED", "GATED", "FAILED", "ABORTED", "COMPLETE"]
    },
    "objective": {"type": "string", "minLength": 1},
    "acceptance_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["waves", "units_of_work"],
      "properties": {
        "waves": {"type": "array", "items": {"type": "object"}},
        "units_of_work": {"type": "array", "items": {"type": "object"}}
      }
    },
    "coordination": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "coordinator_task_identity"],
      "properties": {
        "contract_version": {"type": "string", "minLength": 1},
        "coordinator_task_identity": {"type": "string"}
      }
    },
    "evidence": {"type": "array", "items": {"type": "object"}},
    "jira": {
      "type": "object", "additionalProperties": false, "required": ["issues"],
      "properties": {"issues": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$"}}}
    },
    "release": {
      "type": "object", "additionalProperties": false, "required": ["version", "tag"],
      "properties": {
        "version": {"type": ["string", "null"]},
        "tag": {"type": ["string", "null"]}
      }
    }
  }
}
